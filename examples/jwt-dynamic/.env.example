# JWT Dynamic Example - Environment Variables

# Shared JWT secret (used by tenant-manager and mcp-server)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Service token for MCP server to authenticate with tenant manager
SERVICE_TOKEN=service-token-for-mcp-server-auth

# Tenant Manager URL (for MCP server to resolve tokens)
TENANT_MANAGER_URL=http://localhost:3000

# CORS origin (for MCP server)
CORS_ORIGIN=http://localhost:3001

# Port configuration
TENANT_MANAGER_PORT=3000
MCP_SERVER_PORT=3001
MOCK_INSTAGRAM_PORT=3002
